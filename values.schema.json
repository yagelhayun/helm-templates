    "configMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "as": {
          "type": "string",
          "enum": [
            "env",
            "volume"
          ]
        },
        "mountPath": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      },
      "allOf": [
        {
          "title": "data is required when configMap is enabled",
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "data"
            ]
          }
        },
        {
          "title": "mountPath is required when 'as' is 'volume'",
          "if": {
            "properties": {
              "as": {
                "const": "volume"
              }
            },
            "required": [
              "as"
            ]
          },
          "then": {
            "required": [
              "mountPath"
            ]
          }
        },
        {
          "title": "mountPath is only allowed when 'as' is 'volume'",
          "if": {
            "required": [
              "mountPath"
            ]
          },
          "then": {
            "required": [
              "as"
            ],
            "properties": {
              "as": {
                "const": "volume"
              }
            }
          }
        }
      ]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer",
            "ExternalName"
          ]
        },
        "clusterIP": {
          "type": "string"
        },
        "externalName": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "host"
          ],
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "externalIPs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "publishNotReadyAddresses": {
          "type": "boolean"
        },
        "ipFamily": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "policy": {
              "type": "string",
              "enum": [
                "SingleStack",
                "PreferDualStack",
                "RequireDualStack"
              ]
            },
            "families": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "IPv4",
                  "IPv6"
                ]
              }
            }
          }
        },
        "trafficPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "internal": {
              "type": "string",
              "enum": [
                "Cluster",
                "Local"
              ]
            },
            "external": {
              "type": "string",
              "enum": [
                "Cluster",
                "Local"
              ]
            }
          }
        },
        "sessionAffinity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClientIP",
                "None"
              ]
            },
            "config": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "clientIP": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "timeoutSeconds": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 86400
                    }
                  }
                }
              }
            }
          }
        },
        "loadBalancer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ip": {
              "type": "string"
            },
            "sourceRanges": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "class": {
              "type": "string"
            },
            "nodePort": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "shouldAllocatePorts": {
                  "type": "boolean"
                },
                "healthCheckPort": {
                  "type": "integer",
                  "minimum": 30000,
                  "maximum": 32767
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "title": "service.loadBalancer requires service.type: LoadBalancer",
          "if": {
            "required": [
              "loadBalancer"
            ]
          },
          "then": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "LoadBalancer"
              }
            }
          }
        },
        {
          "title": "service.externalName requires service.type: ExternalName",
          "if": {
            "required": [
              "externalName"
            ]
          },
          "then": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "ExternalName"
              }
            }
          }
        },
        {
          "title": "service.trafficPolicy.external requires service.type NodePort or LoadBalancer",
          "if": {
            "required": [
              "trafficPolicy"
            ],
            "properties": {
              "trafficPolicy": {
                "required": [
                  "external"
                ]
              }
            }
          },
          "then": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "NodePort",
                  "LoadBalancer"
                ]
              }
            }
          }
        },
        {
          "title": "service.sessionAffinity.config requires sessionAffinity.type: ClientIP",
          "if": {
            "required": [
              "sessionAffinity"
            ],
            "properties": {
              "sessionAffinity": {
                "required": [
                  "config"
                ]
              }
            }
          },
          "then": {
            "required": [
              "sessionAffinity"
            ],
            "properties": {
              "sessionAffinity": {
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "ClientIP"
                  }
                }
              }
            }
          }
        }
      ]
