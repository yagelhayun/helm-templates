{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "global"
  ],
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "region"
      ],
      "properties": {
        "region": {
          "type": "string",
          "minLength": 1
        },
        "ignoreLookup": {
          "type": "string",
          "enum": [
            "true",
            "false"
          ]
        },
        "commit": {
          "type": [
            "string",
            "integer",
            "number"
          ]
        },
        "image": {
          "$ref": "./schemas/image.schema.json#/definitions/imageConfig"
        },
        "envFrom": {
          "$ref": "./schemas/env.schema.json#/definitions/envFromConfig"
        },
        "volumes": {
          "$ref": "./schemas/volumes.schema.json#/definitions/volumesConfig"
        },
        "env": {
          "$ref": "./schemas/env.schema.json#/definitions/envConfig"
        },
        "hostAliases": {
          "type": "array",
          "items": {
            "$ref": "./schemas/scheduling.schema.json#/definitions/hostAliasEntry"
          }
        }
      }
    },
    "image": {
      "$ref": "./schemas/image.schema.json#/definitions/imageConfig"
    },
    "ports": {
      "type": "object",
      "additionalProperties": {
        "$ref": "./schemas/image.schema.json#/definitions/portConfig"
      }
    },
    "primaryPort": {
      "type": "string"
    },
    "activeRegion": {
      "type": "string"
    },
    "replicas": {
      "type": "integer",
      "minimum": 0
    },
    "revisionHistoryLimit": {
      "type": "integer",
      "minimum": 1
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "create": {
          "type": "boolean"
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "resources": {
      "$ref": "./schemas/resources.schema.json#/definitions/resourcesConfig"
    },
    "volumes": {
      "$ref": "./schemas/volumes.schema.json#/definitions/volumesConfig"
    },
    "envFrom": {
      "$ref": "./schemas/env.schema.json#/definitions/envFromConfig"
    },
    "env": {
      "$ref": "./schemas/env.schema.json#/definitions/envConfig"
    },
    "probes": {
      "$ref": "./schemas/probes.schema.json#/definitions/probesConfig"
    },
    "labels": {
      "type": "object"
    },
    "annotations": {
      "type": "object"
    },
    "regions": {
      "type": "object"
    },
    "strategy": {
      "$ref": "./schemas/workload.schema.json#/definitions/strategyConfig"
    },
    "topologySpreadConstraints": {
      "$ref": "./schemas/scheduling.schema.json#/definitions/topologySpreadConstraintsConfig"
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "$ref": "./schemas/scheduling.schema.json#/definitions/tolerationConfig"
      }
    },
    "affinity": {
      "$ref": "./schemas/scheduling.schema.json#/definitions/affinityConfig"
    },
    "podSecurityContext": {
      "$ref": "./schemas/security.schema.json#/definitions/podSecurityContextConfig"
    },
    "containerSecurityContext": {
      "$ref": "./schemas/security.schema.json#/definitions/containerSecurityContextConfig"
    },
    "priorityClassName": {
      "type": "string"
    },
    "workload": {
      "$ref": "./schemas/workload.schema.json#/definitions/workloadConfig"
    },
    "statefulSet": {
      "$ref": "./schemas/workload.schema.json#/definitions/statefulSetConfig"
    },
    "configMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "as": {
          "type": "string",
          "enum": [
            "env",
            "volume"
          ]
        },
        "mountPath": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      },
      "allOf": [
        {
          "title": "data is required when configMap is enabled",
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "data"
            ]
          }
        },
        {
          "title": "mountPath is required when 'as' is 'volume'",
          "if": {
            "properties": {
              "as": {
                "const": "volume"
              }
            },
            "required": [
              "as"
            ]
          },
          "then": {
            "required": [
              "mountPath"
            ]
          }
        },
        {
          "title": "mountPath is only allowed when 'as' is 'volume'",
          "if": {
            "required": [
              "mountPath"
            ]
          },
          "then": {
            "required": [
              "as"
            ],
            "properties": {
              "as": {
                "const": "volume"
              }
            }
          }
        }
      ]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer",
            "ExternalName"
          ]
        },
        "clusterIP": {
          "type": "string"
        },
        "externalName": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "host"
          ],
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "externalIPs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "publishNotReadyAddresses": {
          "type": "boolean"
        },
        "ipFamily": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "policy": {
              "type": "string",
              "enum": [
                "SingleStack",
                "PreferDualStack",
                "RequireDualStack"
              ]
            },
            "families": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "IPv4",
                  "IPv6"
                ]
              }
            }
          }
        },
        "trafficPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "internal": {
              "type": "string",
              "enum": [
                "Cluster",
                "Local"
              ]
            },
            "external": {
              "type": "string",
              "enum": [
                "Cluster",
                "Local"
              ]
            }
          }
        },
        "sessionAffinity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClientIP",
                "None"
              ]
            },
            "config": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "clientIP": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "timeoutSeconds": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 86400
                    }
                  }
                }
              }
            }
          }
        },
        "loadBalancer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ip": {
              "type": "string"
            },
            "sourceRanges": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "class": {
              "type": "string"
            },
            "nodePort": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "shouldAllocatePorts": {
                  "type": "boolean"
                },
                "healthCheckPort": {
                  "type": "integer",
                  "minimum": 30000,
                  "maximum": 32767
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "title": "service.loadBalancer requires service.type: LoadBalancer",
          "if": {
            "required": [
              "loadBalancer"
            ]
          },
          "then": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "LoadBalancer"
              }
            }
          }
        },
        {
          "title": "service.externalName requires service.type: ExternalName",
          "if": {
            "required": [
              "externalName"
            ]
          },
          "then": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "ExternalName"
              }
            }
          }
        },
        {
          "title": "service.trafficPolicy.external requires service.type NodePort or LoadBalancer",
          "if": {
            "required": [
              "trafficPolicy"
            ],
            "properties": {
              "trafficPolicy": {
                "required": [
                  "external"
                ]
              }
            }
          },
          "then": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "NodePort",
                  "LoadBalancer"
                ]
              }
            }
          }
        },
        {
          "title": "service.sessionAffinity.config requires sessionAffinity.type: ClientIP",
          "if": {
            "required": [
              "sessionAffinity"
            ],
            "properties": {
              "sessionAffinity": {
                "required": [
                  "config"
                ]
              }
            }
          },
          "then": {
            "required": [
              "sessionAffinity"
            ],
            "properties": {
              "sessionAffinity": {
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "ClientIP"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "pdb": {
      "$ref": "./schemas/workload.schema.json#/definitions/pdbConfig"
    },
    "persistentVolumeClaims": {
      "type": "object",
      "additionalProperties": {
        "$ref": "./schemas/volumes.schema.json#/definitions/pvcConfig"
      }
    },
    "cronJob": {
      "$ref": "./schemas/workload.schema.json#/definitions/cronJobConfig"
    },
    "hpa": {
      "$ref": "./schemas/workload.schema.json#/definitions/hpaConfig"
    },
    "initContainers": {
      "type": "array",
      "items": {
        "$ref": "./schemas/container.schema.json#/definitions/containerSpec"
      }
    },
    "sidecars": {
      "type": "array",
      "items": {
        "$ref": "./schemas/container.schema.json#/definitions/containerSpec"
      }
    },
    "rawManifests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "content"
        ],
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1
          },
          "tpl": {
            "type": "boolean"
          }
        }
      }
    },
    "core": {
      "type": "object"
    },
    "hostAliases": {
      "type": "array",
      "items": {
        "$ref": "./schemas/scheduling.schema.json#/definitions/hostAliasEntry"
      }
    }
  },
  "allOf": [
    {
      "title": "ports[*].nodePort requires service.type NodePort or LoadBalancer",
      "if": {
        "required": [
          "ports"
        ],
        "properties": {
          "ports": {
            "not": {
              "additionalProperties": {
                "not": {
                  "required": [
                    "nodePort"
                  ]
                }
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "service"
        ],
        "properties": {
          "service": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "NodePort",
                  "LoadBalancer"
                ]
              }
            }
          }
        }
      }
    },
    {
      "title": "replicas is required for Deployment and StatefulSet",
      "if": {
        "not": {
          "anyOf": [
            {
              "required": [
                "workload"
              ],
              "properties": {
                "workload": {
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "const": "DaemonSet"
                    }
                  }
                }
              }
            },
            {
              "required": [
                "workload"
              ],
              "properties": {
                "workload": {
                  "required": [
                    "enabled"
                  ],
                  "properties": {
                    "enabled": {
                      "const": false
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "then": {
        "required": [
          "replicas"
        ]
      }
    },
    {
      "title": "statefulSet block is required when workload.type is StatefulSet",
      "if": {
        "required": [
          "workload"
        ],
        "properties": {
          "workload": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "StatefulSet"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "statefulSet"
        ]
      }
    },
    {
      "title": "strategy.partition is only valid for StatefulSet",
      "if": {
        "required": [
          "strategy"
        ],
        "properties": {
          "strategy": {
            "required": [
              "partition"
            ]
          }
        }
      },
      "then": {
        "required": [
          "workload"
        ],
        "properties": {
          "workload": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "StatefulSet"
              }
            }
          }
        }
      }
    },
    {
      "title": "HPA must be disabled for DaemonSet workloads",
      "if": {
        "required": [
          "workload"
        ],
        "properties": {
          "workload": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "DaemonSet"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "hpa": {
            "properties": {
              "enabled": {
                "const": false
              }
            }
          }
        }
      }
    }
  ]
}
