{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["global", "port", "resources"],
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region"],
      "properties": {
        "region":       { "type": "string", "minLength": 1 },
        "ignoreLookup": { "type": "string", "enum": ["true", "false"] },
        "commit":       { "type": ["string", "integer", "number"] },
        "image":        { "$ref": "#/definitions/imageConfig" },
        "envFrom":      { "$ref": "#/definitions/envFromConfig" },
        "volumes":      { "$ref": "#/definitions/volumesConfig" },
        "env":          { "$ref": "#/definitions/envConfig" }
      }
    },

    "image":                        { "$ref": "#/definitions/imageConfig" },
    "port":                         { "type": "integer", "minimum": 1, "maximum": 65535 },
    "portName":                     { "type": "string" },
    "activeRegion":                 { "type": "string" },
    "replicas":                     { "type": "integer", "minimum": 0 },
    "revisionHistoryLimit":         { "type": "integer", "minimum": 1 },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name":   { "type": "string" },
        "create": { "type": "boolean" }
      }
    },
    "terminationGracePeriodSeconds":{ "type": "integer", "minimum": 0 },
    "resources":                    { "$ref": "#/definitions/resourcesConfig" },
    "volumes":                      { "$ref": "#/definitions/volumesConfig" },
    "envFrom":                      { "$ref": "#/definitions/envFromConfig" },
    "env":                          { "$ref": "#/definitions/envConfig" },
    "probes":                       { "$ref": "#/definitions/probesConfig" },
    "labels":                       { "type": "object" },
    "annotations":                  { "type": "object" },
    "regions":                      { "type": "object" },
    "strategy":                     { "$ref": "#/definitions/strategyConfig" },
    "topologySpreadConstraints":    { "$ref": "#/definitions/topologySpreadConstraintsConfig" },
    "workload":                     { "$ref": "#/definitions/workloadConfig" },
    "statefulSet":                  { "$ref": "#/definitions/statefulSetConfig" },

    "configMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "data": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        }
      },
      "if":   { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
      "then": { "required": ["data"] }
    },

    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled":                  { "type": "boolean" },
        "type":                     { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"] },
        "clusterIP":                { "type": "string" },
        "externalName": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host"],
          "properties": {
            "host": { "type": "string", "minLength": 1 }
          }
        },
        "externalIPs":              { "type": "array", "items": { "type": "string" } },
        "appProtocol":              { "type": "string" },
        "publishNotReadyAddresses": { "type": "boolean" },
        "ipFamily": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "policy":   { "type": "string", "enum": ["SingleStack", "PreferDualStack", "RequireDualStack"] },
            "families": { "type": "array", "items": { "type": "string", "enum": ["IPv4", "IPv6"] } }
          }
        },
        "trafficPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "internal": { "type": "string", "enum": ["Cluster", "Local"] },
            "external":  { "type": "string", "enum": ["Cluster", "Local"] }
          }
        },
        "sessionAffinity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type":   { "type": "string", "enum": ["ClientIP", "None"] },
            "config": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "clientIP": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "timeoutSeconds": { "type": "integer", "minimum": 0, "maximum": 86400 }
                  }
                }
              }
            }
          }
        },
        "nodePort": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "port": { "type": "integer", "minimum": 30000, "maximum": 32767 }
          }
        },
        "loadBalancer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ip":           { "type": "string" },
            "sourceRanges": { "type": "array", "items": { "type": "string" } },
            "class":        { "type": "string" },
            "nodePort": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "shouldAllocatePorts": { "type": "boolean" },
                "healthCheckPort": { "type": "integer", "minimum": 30000, "maximum": 32767 }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if":   { "required": ["nodePort"] },
          "then": { "required": ["type"], "properties": { "type": { "const": "NodePort" } } }
        },
        {
          "if":   { "required": ["loadBalancer"] },
          "then": { "required": ["type"], "properties": { "type": { "const": "LoadBalancer" } } }
        },
        {
          "if":   { "required": ["externalName"] },
          "then": { "required": ["type"], "properties": { "type": { "const": "ExternalName" } } }
        },
        {
          "if":   {
            "required": ["trafficPolicy"],
            "properties": { "trafficPolicy": { "required": ["external"] } }
          },
          "then": { "required": ["type"], "properties": { "type": { "enum": ["NodePort", "LoadBalancer"] } } }
        },
        {
          "if":   {
            "required": ["sessionAffinity"],
            "properties": { "sessionAffinity": { "required": ["config"] } }
          },
          "then": {
            "required": ["sessionAffinity"],
            "properties": { "sessionAffinity": { "required": ["type"], "properties": { "type": { "const": "ClientIP" } } } }
          }
        }
      ]
    },

    "pdb": { "$ref": "#/definitions/pdbConfig" },
    "persistentVolumeClaims": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/pvcConfig" }
    },
    "cronJob":        { "$ref": "#/definitions/cronJobConfig" },
    "hpa":            { "$ref": "#/definitions/hpaConfig" },
    "initContainers": { "type": "array", "items": { "$ref": "#/definitions/containerSpec" } },
    "sidecars":       { "type": "array", "items": { "$ref": "#/definitions/containerSpec" } },

    "rawManifests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["content"],
        "properties": {
          "content": { "type": "string", "minLength": 1 },
          "tpl":     { "type": "boolean" }
        }
      }
    },

    "core": { "type": "object" }
  },

  "allOf": [
    {
      "title": "replicas is required for Deployment and StatefulSet",
      "if": {
        "not": {
          "required": ["workload"],
          "properties": {
            "workload": {
              "required": ["type"],
              "properties": { "type": { "const": "DaemonSet" } }
            }
          }
        }
      },
      "then": { "required": ["replicas"] }
    },
    {
      "title": "statefulSet block is required when workload.type is StatefulSet",
      "if": {
        "required": ["workload"],
        "properties": {
          "workload": {
            "required": ["type"],
            "properties": { "type": { "const": "StatefulSet" } }
          }
        }
      },
      "then": { "required": ["statefulSet"] }
    },
    {
      "title": "HPA must be disabled for DaemonSet workloads",
      "if": {
        "required": ["workload"],
        "properties": {
          "workload": {
            "required": ["type"],
            "properties": { "type": { "const": "DaemonSet" } }
          }
        }
      },
      "then": {
        "properties": {
          "hpa": { "properties": { "enabled": { "const": false } } }
        }
      }
    }
  ],

  "definitions": {
    "imageConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url":         { "type": "string" },
        "tag":         { "type": "string" },
        "pullPolicy":  { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "pullSecrets": { "type": "array", "items": { "type": "string" } }
      }
    },

    "resourcesConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {
        "cpu":             { "type": ["string", "number"] },
        "memory":          { "type": "string" },
        "limitMultiplier": { "type": "number", "minimum": 1 }
      }
    },

    "volumeMount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mountPath"],
      "properties": {
        "mountPath":   { "type": "string" },
        "defaultMode": { "type": "integer", "minimum": 0, "maximum": 511 },
        "files":       { "type": "array", "items": { "type": "string" } }
      }
    },

    "emptyVolumeMount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mountPath":   { "type": "string" },
        "defaultMode": { "type": "integer", "minimum": 0, "maximum": 511 }
      }
    },

    "volumesConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secrets":                 { "type": "object", "additionalProperties": { "$ref": "#/definitions/volumeMount" } },
        "configMaps":              { "type": "object", "additionalProperties": { "$ref": "#/definitions/volumeMount" } },
        "empty":                   { "type": "object", "additionalProperties": { "$ref": "#/definitions/emptyVolumeMount" } },
        "persistentVolumeClaims":  { "type": "object", "additionalProperties": { "$ref": "#/definitions/pvcVolumeMount" } }
      }
    },

    "pvcVolumeMount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mountPath"],
      "properties": {
        "mountPath": { "type": "string" },
        "readOnly":  { "type": "boolean" }
      }
    },

    "pvcConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size"],
      "properties": {
        "size":         { "type": "string" },
        "storageClass": { "type": "string" },
        "accessMode":   { "type": "string", "enum": ["ReadWriteOnce", "ReadWriteMany", "ReadOnlyMany"] }
      }
    },

    "pdbConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled":        { "type": "boolean" },
        "minAvailable":   { "type": ["integer", "string"] },
        "maxUnavailable": { "type": ["integer", "string"] }
      },
      "if":   { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
      "then": {
        "anyOf": [
          { "required": ["minAvailable"] },
          { "required": ["maxUnavailable"] }
        ]
      }
    },

    "envFromConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secrets":    { "type": "object" },
        "configMaps": { "type": "object" }
      }
    },

    "envVar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "variable"],
      "properties": {
        "key":      { "type": "string" },
        "variable": { "type": "string" }
      }
    },

    "envResourceMap": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/definitions/envVar" }
      }
    },

    "envConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secrets":    { "$ref": "#/definitions/envResourceMap" },
        "configMaps": { "$ref": "#/definitions/envResourceMap" }
      }
    },

    "probeSpec": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        { "required": ["httpGet"], "not": { "required": ["exec"] } },
        { "required": ["exec"],    "not": { "required": ["httpGet"] } }
      ],
      "properties": {
        "httpGet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path":   { "type": "string" },
            "port":   { "type": ["integer", "string"] },
            "scheme": { "type": "string", "enum": ["HTTP", "HTTPS"] }
          }
        },
        "exec": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command"],
          "properties": {
            "command": { "type": "array", "items": { "type": "string" } }
          }
        },
        "failureThreshold":    { "type": "integer", "minimum": 1 },
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds":       { "type": "integer", "minimum": 1 },
        "successThreshold":    { "type": "integer", "minimum": 1 },
        "timeoutSeconds":      { "type": "integer", "minimum": 1 }
      }
    },

    "probesConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "readiness": { "$ref": "#/definitions/probeSpec" },
        "liveness":  { "$ref": "#/definitions/probeSpec" },
        "startup":   { "$ref": "#/definitions/probeSpec" }
      }
    },

    "containerSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name":      { "type": "string" },
        "image":     { "$ref": "#/definitions/imageConfig" },
        "port":      { "type": "integer", "minimum": 1, "maximum": 65535 },
        "portName":  { "type": "string" },
        "command":   { "type": "array" },
        "args":      { "type": "array" },
        "envFrom":   { "$ref": "#/definitions/envFromConfig" },
        "env":       { "$ref": "#/definitions/envConfig" },
        "resources": { "$ref": "#/definitions/resourcesConfig" },
        "volumes":   { "$ref": "#/definitions/volumesConfig" },
        "probes":    { "$ref": "#/definitions/probesConfig" }
      }
    },

    "cronJobConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled":               { "type": "boolean" },
        "schedule":              { "type": "string" },
        "concurrencyPolicy":     { "type": "string", "enum": ["Allow", "Forbid", "Replace"] },
        "successfulJobsHistory": { "type": "integer", "minimum": 0 },
        "failedJobsHistory":     { "type": "integer", "minimum": 0 },
        "entrypoint": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "command": { "type": "array" },
            "args":    { "type": "array" }
          }
        }
      },
      "if":   { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
      "then": { "required": ["schedule"] }
    },

    "hpaConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled":     { "type": "boolean" },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu":    { "$ref": "#/definitions/hpaMetric" },
            "memory": { "$ref": "#/definitions/hpaMetric" }
          }
        }
      },
      "if":   { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
      "then": { "required": ["maxReplicas"] }
    },

    "workloadConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["Deployment", "StatefulSet", "DaemonSet"] }
      }
    },

    "statefulSetConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serviceName"],
      "properties": {
        "serviceName":          { "type": "string", "minLength": 1 },
        "podManagementPolicy":  { "type": "string", "enum": ["OrderedReady", "Parallel"] },
        "volumeClaimTemplates": {
          "type": "array",
          "items": { "$ref": "#/definitions/volumeClaimTemplate" }
        }
      }
    },

    "volumeClaimTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "size"],
      "properties": {
        "name":         { "type": "string" },
        "storageClass": { "type": "string" },
        "size":         { "type": "string" },
        "accessMode":   { "type": "string", "enum": ["ReadWriteOnce", "ReadWriteMany", "ReadOnlyMany"] }
      }
    },

    "strategyConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type":           { "type": "string", "enum": ["RollingUpdate", "Recreate", "OnDelete"] },
        "maxUnavailable": { "type": ["string", "integer"] },
        "maxSurge":       { "type": ["string", "integer"] },
        "partition":      { "type": "integer", "minimum": 0 }
      }
    },

    "topologySpreadConstraintsConfig": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["maxSkew", "topologyKey", "whenUnsatisfiable"],
        "properties": {
          "maxSkew":           { "type": "integer", "minimum": 1 },
          "topologyKey":       { "type": "string" },
          "whenUnsatisfiable": { "type": "string", "enum": ["DoNotSchedule", "ScheduleAnyway"] }
        }
      }
    },

    "hpaMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["averageUtilization"],
      "properties": {
        "averageUtilization": { "type": "integer", "minimum": 1, "maximum": 99 }
      }
    }
  }
}
