  "allOf": [
    {
      "title": "ports[*].nodePort requires service.type NodePort or LoadBalancer",
      "if": {
        "required": [
          "ports"
        ],
        "properties": {
          "ports": {
            "not": {
              "additionalProperties": {
                "not": {
                  "required": [
                    "nodePort"
                  ]
                }
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "service"
        ],
        "properties": {
          "service": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "NodePort",
                  "LoadBalancer"
                ]
              }
            }
          }
        }
      }
    },
    {
      "title": "replicas is required for Deployment and StatefulSet",
      "if": {
        "not": {
          "anyOf": [
            {
              "required": [
                "workload"
              ],
              "properties": {
                "workload": {
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "const": "DaemonSet"
                    }
                  }
                }
              }
            },
            {
              "required": [
                "workload"
              ],
              "properties": {
                "workload": {
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "const": "CronJob"
                    }
                  }
                }
              }
            },
            {
              "required": [
                "workload"
              ],
              "properties": {
                "workload": {
                  "required": [
                    "enabled"
                  ],
                  "properties": {
                    "enabled": {
                      "const": false
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "then": {
        "required": [
          "replicas"
        ]
      }
    },
    {
      "title": "statefulSet block is required when workload.type is StatefulSet",
      "if": {
        "required": [
          "workload"
        ],
        "properties": {
          "workload": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "StatefulSet"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "statefulSet"
        ]
      }
    },
    {
      "title": "strategy.partition is only valid for StatefulSet",
      "if": {
        "required": [
          "strategy"
        ],
        "properties": {
          "strategy": {
            "required": [
              "partition"
            ]
          }
        }
      },
      "then": {
        "required": [
          "workload"
        ],
        "properties": {
          "workload": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "StatefulSet"
              }
            }
          }
        }
      }
    },
    {
      "title": "HPA must be disabled for DaemonSet workloads",
      "if": {
        "required": [
          "workload"
        ],
        "properties": {
          "workload": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "DaemonSet"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "hpa": {
            "properties": {
              "enabled": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "title": "cronJob block is required when workload.type is CronJob",
      "if": {
        "required": [
          "workload"
        ],
        "properties": {
          "workload": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "CronJob"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "cronJob"
        ]
      }
    },
    {
      "title": "HPA must be disabled for CronJob workloads",
      "if": {
        "required": [
          "workload"
        ],
        "properties": {
          "workload": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "CronJob"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "hpa": {
            "properties": {
              "enabled": {
                "const": false
              }
            }
          }
        }
      }
    }
  ]
