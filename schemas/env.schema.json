{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "envVar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "variable"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "variable": {
          "type": "string"
        }
      }
    },
    "envResourceMap": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/definitions/envVar"
        }
      }
    },
    "envFromConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secrets": {
          "type": "object"
        },
        "configMaps": {
          "type": "object"
        }
      }
    },
    "envConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secrets": {
          "$ref": "#/definitions/envResourceMap"
        },
        "configMaps": {
          "$ref": "#/definitions/envResourceMap"
        }
      }
    }
  }
}
