{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "volumeMount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mountPath"
      ],
      "properties": {
        "mountPath": {
          "type": "string"
        },
        "defaultMode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 511
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "emptyVolumeMount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mountPath": {
          "type": "string"
        },
        "defaultMode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 511
        }
      }
    },
    "pvcVolumeMount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mountPath"
      ],
      "properties": {
        "mountPath": {
          "type": "string"
        },
        "readOnly": {
          "type": "boolean"
        }
      }
    },
    "hostPathVolumeMount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostPath",
        "mountPath"
      ],
      "properties": {
        "hostPath": {
          "type": "string"
        },
        "mountPath": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "",
            "DirectoryOrCreate",
            "Directory",
            "FileOrCreate",
            "File",
            "Socket",
            "CharDevice",
            "BlockDevice"
          ]
        }
      }
    },
    "volumesConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secrets": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/volumeMount"
          }
        },
        "configMaps": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/volumeMount"
          }
        },
        "emptyDirs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/emptyVolumeMount"
          }
        },
        "pvcs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/pvcVolumeMount"
          }
        },
        "hostPaths": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/hostPathVolumeMount"
          }
        }
      }
    },
    "pvcConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size"
      ],
      "properties": {
        "size": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "accessMode": {
          "type": "string",
          "enum": [
            "ReadWriteOnce",
            "ReadWriteMany",
            "ReadOnlyMany"
          ]
        }
      }
    },
    "volumeClaimTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "size"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "size": {
          "type": "string"
        },
        "accessMode": {
          "type": "string",
          "enum": [
            "ReadWriteOnce",
            "ReadWriteMany",
            "ReadOnlyMany"
          ]
        }
      }
    }
  }
}
