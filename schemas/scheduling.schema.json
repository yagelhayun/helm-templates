{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "tolerationConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "operator": {
          "type": "string",
          "enum": [
            "Exists",
            "Equal"
          ]
        },
        "value": {
          "type": "string"
        },
        "effect": {
          "type": "string",
          "enum": [
            "NoSchedule",
            "PreferNoSchedule",
            "NoExecute"
          ]
        },
        "tolerationSeconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "matchExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "operator"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "operator": {
          "type": "string",
          "enum": [
            "In",
            "NotIn",
            "Exists",
            "DoesNotExist",
            "Gt",
            "Lt"
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "preferredNodeExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weight",
        "key",
        "operator"
      ],
      "properties": {
        "weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "key": {
          "type": "string"
        },
        "operator": {
          "type": "string",
          "enum": [
            "In",
            "NotIn",
            "Exists",
            "DoesNotExist",
            "Gt",
            "Lt"
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "topologyKeyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topologyKey"
      ],
      "properties": {
        "topologyKey": {
          "type": "string"
        }
      }
    },
    "weightedTopologyKeyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weight",
        "topologyKey"
      ],
      "properties": {
        "weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "topologyKey": {
          "type": "string"
        }
      }
    },
    "topologySpreadConstraintsConfig": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "maxSkew",
          "topologyKey",
          "whenUnsatisfiable"
        ],
        "properties": {
          "maxSkew": {
            "type": "integer",
            "minimum": 1
          },
          "topologyKey": {
            "type": "string"
          },
          "whenUnsatisfiable": {
            "type": "string",
            "enum": [
              "DoNotSchedule",
              "ScheduleAnyway"
            ]
          }
        }
      }
    },
    "affinityConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeAffinity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/matchExpression"
              }
            },
            "preferred": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/preferredNodeExpression"
              }
            }
          },
          "allOf": [
            {
              "title": "affinity.nodeAffinity must specify at least 'required' or 'preferred'",
              "anyOf": [
                {
                  "required": [
                    "required"
                  ]
                },
                {
                  "required": [
                    "preferred"
                  ]
                }
              ]
            }
          ]
        },
        "podAntiAffinity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/topologyKeyEntry"
              }
            },
            "preferred": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/weightedTopologyKeyEntry"
              }
            }
          },
          "allOf": [
            {
              "title": "affinity.podAntiAffinity must specify at least 'required' or 'preferred'",
              "anyOf": [
                {
                  "required": [
                    "required"
                  ]
                },
                {
                  "required": [
                    "preferred"
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    "hostAliasEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ip",
        "hostnames"
      ],
      "properties": {
        "ip": {
          "type": "string"
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
